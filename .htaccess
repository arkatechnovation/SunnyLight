RewriteEngine On
RewriteBase /sunnylight_new/

# Canonical host only for production, keep localhost local
RewriteCond %{HTTP_HOST} ^(www\.)?sunnylights\.co\.in$ [NC]
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://sunnylights.co.in%{REQUEST_URI} [L,R=301]

# Remove .php extension from URL
RewriteCond %{THE_REQUEST} \s/sunnylight_new/([^.]+)\.php [NC]
RewriteRule ^([^.]+)\.php$ %1 [R=301,L]

# Internally map extensionless URL to .php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/]+)/?$ $1.php [L]

# Prevent directory listing
Options -Indexes

# cPanel-generated handler commented out for local XAMPP environment
# <IfModule mime_module>
#   AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
# </IfModule>

